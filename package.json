{
  "name": "my-2d-game-lib",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./geometry": {
      "types": "./dist/geometry/index.d.ts",
      "import": "./dist/geometry/index.js",
      "default": "./dist/geometry/index.js"
    },
    "./collision": {
      "types": "./dist/collision/index.d.ts",
      "import": "./dist/collision/index.js",
      "default": "./dist/collision/index.js"
    },
    "./spatial": {
      "types": "./dist/spatial/index.d.ts",
      "import": "./dist/spatial/index.js",
      "default": "./dist/spatial/index.js"
    },
    "./grid": {
      "types": "./dist/grid/index.d.ts",
      "import": "./dist/grid/index.js",
      "default": "./dist/grid/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "description": "2D game math, physics geometry, and spatial data structures library in TypeScript",
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "game-math",
    "2d-games",
    "vector2",
    "collision",
    "spatial-hash",
    "typescript"
  ],
  "author": "",
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.0.8"
  }
}